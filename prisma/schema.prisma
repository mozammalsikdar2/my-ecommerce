generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MODERATOR
  ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model SiteSettings {
  id Int @id @default(1)

  storeName  String @default("ALIF STORE")
  tagline    String @default("Premium Quality & Trusted Online Shopping")
  logoUrl    String @default("")
  faviconUrl String @default("/favicon.ico")

  primaryColor   String @default("#0f766e")
  secondaryColor String @default("#111827")
  fontFamily     String @default("Inter")
  menuItems      Json   @default("[{\"label\":\"Home\",\"href\":\"/\"},{\"label\":\"Products\",\"href\":\"/#products\"},{\"label\":\"Track Order\",\"href\":\"/track-order\"}]")

  footerText     String @default("© 2026 Alif Store. All rights reserved.")
  contactPhone   String @default("+880 1700-000000")
  contactEmail   String @default("support@alifstore.com")
  contactAddress String @default("Dhaka, Bangladesh")

  facebookUrl    String @default("https://facebook.com")
  instagramUrl   String @default("https://instagram.com")
  youtubeUrl     String @default("https://youtube.com")
  whatsappNumber String @default("8801700000000")
  messengerUsername String @default("") // Facebook Page username or numeric Page ID for m.me link

  announcementText      String    @default("Free Delivery on orders over 2,000 BDT! Cash on Delivery Available.")
  heroTitle             String    @default("Discover Exclusive Collections for Everyday Life")
  heroSubtitle          String    @default("Shop top-rated products with fast nationwide delivery and 100% authentic guarantee.")
  heroButtonText        String    @default("Shop Now")
  heroButtonLink        String    @default("/#products")
  heroImage             String    @default("https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1200&q=80")
  flashSaleEndsAt       DateTime?
  deliveryChargeInside  Int       @default(60)
  deliveryChargeOutside Int       @default(120)

  updatedAt DateTime @updatedAt
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?       @unique
  password     String
  address      String?
  role         Role          @default(CUSTOMER)
  isActive     Boolean       @default(true)
  twoFactorEnabled Boolean   @default(true)
  twoFactorChannel String    @default("EMAIL")
  orders       Order[]
  authSessions AuthSession[]
  resetTokens  PasswordResetToken[]
  twoFactorTokens AdminTwoFactorToken[]
  wishlistItems WishlistItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AuthSession {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Float
  minOrderAmount Float        @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  imageUrl      String?
  subCategories SubCategory[]
  products      Product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  createdAt  DateTime  @default(now())
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  price         Float
  discountPrice Float?
  stock         Int              @default(0)
  image         String
  images        String[]         @default([])
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId String?
  subCategory   SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  isFeatured    Boolean          @default(false)
  isFlashSale   Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  orderItems    OrderItem[]
  wishlistedBy  WishlistItem[]
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String?
  color      String?
  price      Float?
  stock      Int         @default(0)
  sku        String?
  createdAt  DateTime    @default(now())
  orderItems OrderItem[]
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String
  customerEmail      String?
  customerIp         String?
  deliveryAddress    String
  deliveryZone       String      @default("INSIDE_DHAKA")
  subtotal           Float
  discountAmount     Float       @default(0)
  couponCode         String?
  deliveryCharge     Float
  totalAmount        Float
  paymentMethod      String      @default("COD")
  transactionId      String?
  paymentSessionId   String?
  paymentCheckoutUrl String?
  paymentStatus      String      @default("UNPAID")
  orderStatus        String      @default("PENDING") // PENDING | CONFIRMED | SHIPPED | DELIVERED | RETURNED | CANCELLED
  stockRestored      Boolean     @default(false) // Prevent duplicate stock increments on webhook retries
  courierProvider    String?
  consignmentId      String?
  trackingCode       String?
  courierStatus      String?
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([customerIp, createdAt])
  @@index([customerPhone, createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantInfo String?
  quantity    Int
  price       Float
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  buttonText String   @default("Shop Now")
  buttonLink String   @default("/")
  imageUrl   String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model HomepageSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique
  title      String
  subtitle   String?
  imageUrl   String?
  linkUrl    String?
  order      Int
  isVisible  Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model PaymentSettings {
  id Int @id @default(1)

  // Cash on Delivery
  codEnabled Boolean @default(true)

  // 1. bKash Tokenized Checkout Credentials
  bkashEnabled        Boolean   @default(false)
  bkashSandbox        Boolean   @default(true)
  bkashAppKey         String    @default("")
  bkashAppSecret      String    @default("")
  bkashUsername       String    @default("")
  bkashPassword       String    @default("")
  bkashAccessToken    String    @default("")
  bkashTokenExpiresAt DateTime?

  // 2. Nagad Checkout Credentials
  nagadEnabled    Boolean @default(false)
  nagadSandbox    Boolean @default(true)
  nagadMerchantId String  @default("")
  nagadPublicKey  String  @default("")
  nagadPrivateKey String  @default("")

  // 3. SSLCommerz Credentials
  sslEnabled       Boolean @default(false)
  sslSandbox       Boolean @default(true)
  sslStoreId       String  @default("")
  sslStorePassword String  @default("")

  // 4. Stripe Credentials
  stripeEnabled        Boolean @default(false)
  stripePublishableKey String  @default("")
  stripeSecretKey      String  @default("")
  stripeCurrency       String  @default("bdt")

  updatedAt DateTime @updatedAt
}

model LogisticsSettings {
  id Int @id @default(1)

  // 1. Steadfast Courier API Credentials
  steadfastEnabled   Boolean @default(false)
  steadfastApiKey    String  @default("")
  steadfastSecretKey String  @default("")
  steadfastWebhookSecret String @default("")

  // 2. Pathao Merchant API Credentials
  pathaoEnabled       Boolean @default(false)
  pathaoSandbox       Boolean @default(true)
  pathaoClientId      String  @default("")
  pathaoClientSecret  String  @default("")
  pathaoWebhookSecret String  @default("")
  pathaoUsername      String  @default("")
  pathaoPassword      String  @default("")
  pathaoStoreId       Int     @default(0)
  pathaoDefaultCityId Int     @default(1)
  pathaoDefaultZoneId Int     @default(298)

  // 3. Order Confirmation SMS Gateway (BulkSMSBD / Custom HTTP API)
  smsEnabled           Boolean @default(false)
  smsProvider          String  @default("BULKSMSBD")
  smsApiUrl            String  @default("https://bulksmsbd.net/api/smsapi")
  smsApiKey            String  @default("")
  smsSenderId          String  @default("")
  orderConfirmTemplate String  @default("Dear {customerName}, your order {orderNumber} of BDT {totalAmount} at {storeName} is confirmed! Track: {trackUrl}")
  orderShippedTemplate String  @default("Dear {customerName}, your order {orderNumber} has been shipped via {courier}. Tracking Code: {trackingCode}")

  updatedAt DateTime @updatedAt
}

model EmailSettings {
  id                 Int      @id @default(1)
  emailEnabled       Boolean  @default(false)
  provider           String   @default("SMTP")
  smtpHost           String   @default("smtp.gmail.com")
  smtpPort           Int      @default(587)
  smtpSecure         Boolean  @default(false)
  smtpUser           String   @default("")
  smtpPass           String   @default("")
  resendApiKey       String   @default("")
  senderName         String   @default("ALIF STORE")
  senderEmail        String   @default("orders@yourdomain.com")
  attachPdfInvoice   Boolean  @default(true)
  sendOnOrderCreate  Boolean  @default(true)
  sendOnStatusUpdate Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model MarketingSettings {
  id                  Int      @id @default(1)
  ga4Enabled          Boolean  @default(false)
  ga4MeasurementId    String   @default("")
  gtmEnabled          Boolean  @default(false)
  gtmContainerId      String   @default("")
  metaPixelEnabled    Boolean  @default(false)
  metaPixelId         String   @default("")
  metaCapiAccessToken String   @default("")
  metaTestEventCode   String   @default("") // Optional: used in Meta Events Manager "Test Events" tab
  updatedAt           DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String   @db.Text
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String
  identifier String
  codeHash   String
  attempts   Int      @default(0)
  used       Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model AdminTwoFactorToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model BlockedPhone {
  id          String   @id @default(cuid())
  phone       String   @unique
  reason      String   @default("Fake / Fraudulent order")
  orderNumber String?
  blockedBy   String?
  createdAt   DateTime @default(now())
}
